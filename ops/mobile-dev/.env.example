# Yunicity mobile-dev — EXAMPLE ONLY
# Copy to ops/mobile-dev/.env (gitignored) and replace every change-me value.
# Never commit .env. Never reuse QA or production credentials.
#
# Compose ${VAR:?...} fails when a variable is missing or empty.
# It does NOT reject placeholder strings such as change-me-... .
# Replace and verify all placeholders before any launch.

# --- Frozen backend snapshot (required for image build + Postgres init) ---
# Must point to a temporary checkout/archive of the common FastAPI monorepo
# at one verified full Git SHA, OUTSIDE the active Web worktree and OUTSIDE
# the yunimobile repository. Create that snapshot in a later launch ticket —
# not during this preparation pass. Leave empty here; pass a path only when
# building or validating with an explicit environment value.
YUNICITY_REPO_ROOT=

# --- API publish (host) ---
# Bind to the workstation LAN IPv4 (re-check before launch), not 0.0.0.0.
MOBILE_API_BIND_HOST=192.168.1.180
MOBILE_API_HOST_PORT=8011

# --- Dedicated Postgres (Compose project yunicity-mobile-dev) ---
POSTGRES_DB=yunicity_mobile_dev
POSTGRES_USER=yunicity_mobile_dev
POSTGRES_PASSWORD=change-me-mobile-dev-postgres-password

# --- Auth secrets (local .env only; generate dedicated values) ---
JWT_SECRET_KEY=change-me-mobile-dev-jwt-secret-at-least-32-chars
REFRESH_TOKEN_PEPPER=change-me-mobile-dev-refresh-pepper-32chars
RATE_LIMIT_KEY_PEPPER=change-me-mobile-dev-rate-limit-pepper

# --- App (non-secret defaults safe for a disposable mobile stack) ---
APP_NAME=Yunicity Mobile Dev API
APP_ENV=dev
DEBUG=true
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
EMAIL_PROVIDER=console
EXPO_PUSH_ENABLED=false
REGISTRATION_MODE=pilot
REGISTRATION_CLOSES_AT=2099-01-01T00:00:00+00:00

# Media paths inside the backend image (owned by user app; no root init).
MEDIA_UPLOAD_DIR=/data/media
MEDIA_PUBLIC_BASE_URL=http://192.168.1.180:8011
LOCAL_VIDEO_STORAGE_BACKEND=filesystem
STORY_MEDIA_STORAGE_BACKEND=filesystem
STORY_MEDIA_UPLOAD_DIR=/data/media/stories
PROFILE_MEDIA_STORAGE_BACKEND=filesystem
PROFILE_MEDIA_UPLOAD_DIR=/data/media/profiles
MANAGED_PERSISTENT_MEDIA_ENABLED=false

# CORS: leave unset unless a demonstrated need appears.
# CORS_ORIGINS=

# Explicitly NOT set (QA-only markers):
# YUNICITY_QA_MODE
# YUNICITY_QA_RUN_TOKEN
