{
  "expo": {
    "name": "Yunicity",
    "slug": "yunicity-mobile",
    "version": "0.0.1",
    "orientation": "portrait",
    "icon": "./assets/yunicity-mascot.png",
    "scheme": "yunicity",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yunicity.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/yunicity-mascot.png",
        "backgroundColor": "#fafafa"
      },
      "package": "com.yunicity.mobile"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Yunicity utilise la caméra pour scanner les Passport citoyens chez les partenaires."
        }
      ],
      "expo-font",
      [
        "expo-notifications",
        {
          "color": "#2A2FFF"
        }
      ],
      "expo-secure-store",
      "expo-splash-screen",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
